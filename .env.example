# OpenAI API key used to classify incoming emails (src/lib/aiService.ts)
OPENAI_API_KEY=

# Optional: override the default classification model
OPENAI_MODEL=gpt-4o-mini

# Confidence threshold (0-100) for accepting the LLM's category; below it,
# the email is marked "sin_clasificar" instead of a possibly-wrong guess.
CLASSIFICATION_CONFIDENCE_THRESHOLD=60

# Mail account used to read the inbox (IMAP) and send real forward emails (SMTP)
MAILING_SERVICE=outlook
MAIL_USER=
MAIL_PASSWORD=
