OPENAI_API_KEY=

# Optional: override the default classification model
OPENAI_MODEL=gpt-4o-mini

# Outlook/Microsoft 365 account used to send real forward emails (src/lib/mailService.ts)
MAILING_SERVICE=outlook
MAIL_USER=
MAIL_PASSWORD=
